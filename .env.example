# Copy to .env and edit.
DBNAME=notes
DB_USER=notes
DB_PASSWORD=change_me

# Host port for the DB (to read it from QGIS, DBeaver, Python...).
DB_PUBLIC_PORT=5432
PG_SHARED_BUFFERS=1GB

# OSM-Notes-Ingestion repo and git ref to build (branch, tag or commit).
# Our fork has a fix so the daemon can start on an empty DB.
INGESTION_REPO=https://github.com/Rub21/OSM-Notes-Ingestion.git
INGESTION_REF=fix/daemon-empty-db

LOG_LEVEL=INFO
DAEMON_SLEEP_INTERVAL=60
MAX_THREADS=4

# OSM asks for an identifiable User-Agent with a contact.
DOWNLOAD_USER_AGENT="osm-notes-classifier/0.1 (contact: your-email@example.com)"

# overpass-api.de does not answer from some servers (e.g. our Hetzner box).
OVERPASS_INTERPRETER=https://maps.mail.ru/osm/tools/overpass/api/interpreter

# Extractor (docker compose run --rm extractor)
SAMPLE_SIZE=1000
# "und" = language not detected (short or empty notes like "ok", "asdf").
LANGS=es,en,und

# Labeling page (labeler service). The extractor sets this password on the
# limited `labeler` DB role.
LABELER_DB_PASSWORD=change_me_too
LABELER_PORT=8090

# Login with OSM (openstreetmap.org > My Settings > OAuth 2 applications).
# Redirect URI: ${PUBLIC_URL}/auth/callback   Permission: read_prefs
# Leave OSM_CLIENT_ID empty to label without login (local dev).
PUBLIC_URL=https://osm-notes-labels.rub21.com
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=
# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel).
CLOUDFLARE_TUNNEL_TOKEN=

# Seconds between language updates for new notes (lang-updater service).
LANG_WATCH_INTERVAL=300
